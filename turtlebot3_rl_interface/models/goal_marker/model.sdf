<?xml version="1.0" ?>
<sdf version="1.6">
    <model name="goal_marker">
        <static>true</static>

        <link name="goal_link">
            <pose>0 0 0.002 0 0 0</pose>

            <visual name="goal_circle_visual">
                <geometry>
                    <cylinder>
                        <radius>0.15</radius>
                        <length>0.002</length>
                    </cylinder>
                </geometry>

                <material>
                    <ambient>0.0 1.0 0.0 1.0</ambient>
                    <diffuse>0.0 1.0 0.0 1.0</diffuse>
                </material>
            </visual>
        </link>
    </model>
</sdf>