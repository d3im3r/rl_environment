<?xml version="1.0" ?>
<sdf version="1.6">
    <world name="d3im3r_stage_03_left_right_choice">

        <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
            <ros>
                <namespace>/gazebo</namespace>
            </ros>
            <update_rate>20.0</update_rate>
        </plugin>

        <light name="sun" type="directional">
            <cast_shadows>true</cast_shadows>
            <pose>0 0 10 0 0 0</pose>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <direction>-0.5 0.1 -0.9</direction>
        </light>

        <model name="ground_plane">
            <static>true</static>
            <link name="link">
                <collision name="collision">
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                            <size>10 10</size>
                        </plane>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                            <size>10 10</size>
                        </plane>
                    </geometry>
                    <material>
                        <ambient>0.5 0.5 0.5 1</ambient>
                        <diffuse>0.5 0.5 0.5 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <include>
            <uri>model://d3im3r_grid</uri>
            <pose>0 0 0 0 0 0</pose>
        </include>

        <include>
            <uri>model://d3im3r_arena_walls</uri>
            <pose>0 0 0 0 0 0</pose>
        </include>

        <model name="goal_marker">
    <static>false</static>

    <pose>1.5 0.0 0.03 0 0 0</pose>

    <link name="link">
        <gravity>false</gravity>
        <kinematic>true</kinematic>

        <visual name="visual">
            <geometry>
                <cylinder>
                    <radius>0.18</radius>
                    <length>0.02</length>
                </cylinder>
            </geometry>
            <material>
                <ambient>0.0 1.0 0.0 1.0</ambient>
                <diffuse>0.0 1.0 0.0 1.0</diffuse>
            </material>
        </visual>
    </link>
</model>

        <model name="left_obstacle">
            <static>true</static>
            <pose>0.0 0.55 0.25 0 0 0</pose>
            <link name="link">
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>0.45 0.45 0.50</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>0.45 0.45 0.50</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.15 0.15 0.8 1</ambient>
                        <diffuse>0.15 0.15 0.8 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <model name="right_obstacle">
            <static>true</static>
            <pose>0.0 -0.55 0.25 0 0 0</pose>
            <link name="link">
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>0.45 0.45 0.50</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>0.45 0.45 0.50</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.15 0.15 0.8 1</ambient>
                        <diffuse>0.15 0.15 0.8 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

    </world>
</sdf>