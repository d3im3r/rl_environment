<?xml version="1.0"?>
<sdf version="1.6">
    <model name="d3im3r_grid">
        <static>true</static>

        <!--
            d3im3r_grid
            - Grid size: 10 m x 10 m
            - Grid spacing: 1 m
            - Positive X axis: red
            - Positive Y axis: green
            - Negative axes remain as normal grid lines
        -->

        <!-- Lines parallel to X axis: y = constant -->
        <link name="grid_x">
            <visual name="x_-5">
                <pose>0 -5 0.006 0 0 0</pose>
                <geometry>
                    <box>
                        <size>10 0.015 0.002</size>
                    </box>
                </geometry>
                <material>
                    <ambient>0.05 0.05 0.05 1</ambient>
                    <diffuse>0.05 0.05 0.05 1</diffuse>
                </material>
            </visual>

            <visual name="x_-4">
                <pose>0 -4 0.006 0 0 0</pose>
                <geometry>
                    <box>
                        <size>10 0.015 0.002</size>
                    </box>
                </geometry>
                <material>
                    <ambient>0.05 0.05 0.05 1</ambient>
                    <diffuse>0.05 0.05 0.05 1</diffuse>
                </material>
            </visual>

            <visual name="x_-3">
                <pose>0 -3 0.006 0 0 0</pose>
                <geometry>
                    <box>
                        <size>10 0.015 0.002</size>
                    </box>
                </geometry>
                <material>
                    <ambient>0.05 0.05 0.05 1</ambient>
