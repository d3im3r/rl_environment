                    <box>
                        <size>10 0.015 0.002</size>
                    </box>
                </geometry>
                <material>
                    <ambient>0.05 0.05 0.05 1</ambient>
                    <diffuse>0.05 0.05 0.05 1</diffuse>
                </material>
            </visual>

            <!-- Positive X axis: from x = 0 to x = 5, y = 0 -->
            <visual name="positive_x_axis">
                <pose>2.5 0 0.008 0 0 0</pose>
                <geometry>
                    <box>
                        <size>5 0.030 0.004</size>
                    </box>
                </geometry>
                <material>
                    <ambient>0.8 0.0 0.0 1</ambient>
                    <diffuse>0.8 0.0 0.0 1</diffuse>
                </material>
            </visual>

            <!-- Negative side of y = 0 remains as a normal grid line -->
            <visual name="negative_x_axis_grid">
                <pose>-2.5 0 0.006 0 0 0</pose>
                <geometry>
                    <box>
                        <size>5 0.015 0.002</size>
                    </box>
                </geometry>
                <material>
                    <ambient>0.05 0.05 0.05 1</ambient>
                    <diffuse>0.05 0.05 0.05 1</diffuse>
                </material>
            </visual>

            <visual name="x_1">
